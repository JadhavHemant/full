        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route=~\"/api/roles.*\"}[5m])) by (le))",
          "legendFormat": "p95 roles",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{route=~\"/api/roles.*\"}[5m])) by (le))",
